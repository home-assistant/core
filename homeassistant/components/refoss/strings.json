{
  "config": {
    "error": {
      "invalid_networks": "Enter IPv4 addresses or networks from /24 to /32, separated by commas."
    },
    "abort": {
      "no_devices_found": "[%key:common::config_flow::abort::no_devices_found%]",
      "single_instance_allowed": "[%key:common::config_flow::abort::single_instance_allowed%]"
    },
    "step": {
      "user": {
        "description": "Devices on this network are discovered automatically. To find devices on another VLAN, list its IPv4 addresses or subnets, separated by commas. English and Chinese commas are both accepted. Subnets must be /24 to /32.",
        "data": {
          "networks": "Networks"
        },
        "data_description": {
          "networks": "Optional. Leave empty to discover devices on this network. For other VLANs, comma separated, e.g. 192.168.20.0/24, 10.1.2.17"
        }
      }
    }
  },
  "options": {
    "error": {
      "invalid_networks": "[%key:component::refoss::config::error::invalid_networks%]"
    },
    "step": {
      "init": {
        "data": {
          "networks": "[%key:component::refoss::config::step::user::data::networks%]"
        },
        "data_description": {
          "networks": "[%key:component::refoss::config::step::user::data_description::networks%]"
        },
        "description": "[%key:component::refoss::config::step::user::description%]"
      }
    }
  },
  "entity": {
    "sensor": {
      "current": {
        "name": "{channel_name} current"
      },
      "power": {
        "name": "{channel_name} power"
      },
      "power_factor": {
        "name": "{channel_name} power factor"
      },
      "this_month_energy": {
        "name": "{channel_name} this month energy"
      },
      "this_month_energy_returned": {
        "name": "{channel_name} this month energy returned"
      },
      "voltage": {
        "name": "{channel_name} voltage"
      }
    }
  }
}
