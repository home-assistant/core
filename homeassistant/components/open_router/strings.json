{
  "config": {
    "abort": {
      "already_configured": "[%key:common::config_flow::abort::already_configured_service%]"
    },
    "error": {
      "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]",
      "unknown": "[%key:common::config_flow::error::unknown%]"
    },
    "step": {
      "user": {
        "data": {
          "api_key": "[%key:common::config_flow::data::api_key%]"
        },
        "data_description": {
          "api_key": "An OpenRouter API key"
        }
      }
    }
  },
  "config_subentries": {
    "ai_task_data": {
      "abort": {
        "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]",
        "entry_not_loaded": "The main integration entry is not loaded. Please ensure the integration is loaded before reconfiguring.",
        "unknown": "[%key:common::config_flow::error::unknown%]"
      },
      "entry_type": "AI task",
      "initiate_flow": {
        "reconfigure": "Reconfigure AI task",
        "user": "Add AI task"
      },
      "step": {
        "init": {
          "data": {
            "model": "[%key:common::generic::model%]"
          },
          "description": "Configure the AI task"
        }
      }
    },
    "conversation": {
      "abort": {
        "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]",
        "entry_not_loaded": "[%key:component::open_router::config_subentries::ai_task_data::abort::entry_not_loaded%]",
        "unknown": "[%key:common::config_flow::error::unknown%]"
      },
      "entry_type": "Conversation agent",
      "initiate_flow": {
        "reconfigure": "Reconfigure conversation agent",
        "user": "Add conversation agent"
      },
      "step": {
        "init": {
          "data": {
            "llm_hass_api": "[%key:common::config_flow::data::llm_hass_api%]",
            "model": "[%key:common::generic::model%]",
            "prompt": "[%key:common::config_flow::data::prompt%]",
            "web_search": "Enable web search"
          },
          "data_description": {
            "llm_hass_api": "Select which tools the model can use to interact with your devices and entities.",
            "model": "The model to use for the conversation agent",
            "prompt": "Instruct how the LLM should respond. This can be a template.",
            "web_search": "Allow the model to search the web for answers"
          },
          "description": "Configure the conversation agent"
        }
      }
    }
  },
  "exceptions": {
    "api_error": {
      "message": "Error communicating with the OpenRouter API: {error}"
    },
    "cannot_connect": {
      "message": "Unable to connect to OpenRouter"
    },
    "empty_response": {
      "message": "OpenRouter returned an empty response"
    },
    "fetch_models_failed": {
      "message": "Failed to fetch the models from OpenRouter"
    },
    "file_not_found": {
      "message": "`{file_path}` does not exist"
    },
    "invalid_api_key": {
      "message": "Invalid API key"
    },
    "invalid_image_returned": {
      "message": "OpenRouter returned an invalid image"
    },
    "invalid_schema_reference": {
      "message": "Invalid OpenRouter output schema reference: {reference}"
    },
    "json_parse_error": {
      "message": "Error with OpenRouter structured response"
    },
    "no_image_returned": {
      "message": "OpenRouter did not return an image"
    },
    "response_not_found": {
      "message": "Last content in chat log is not an AssistantContent"
    },
    "tool_args_parse_error": {
      "message": "OpenRouter returned invalid tool arguments: {error}"
    },
    "unsupported_file_type": {
      "message": "Only images and PDF are supported by the OpenRouter API, `{file_path}` is not an image file or PDF"
    },
    "unsupported_schema_reference": {
      "message": "Unsupported OpenRouter output schema reference: {reference}"
    }
  },
  "selector": {
    "web_search_modes": {
      "options": {
        "off": "[%key:common::state::off%]",
        "plugin": "Plugin (deprecated)",
        "tool": "[%key:common::state::auto%]",
        "tool_exa": "Exa",
        "tool_firecrawl": "Firecrawl",
        "tool_native": "Model native",
        "tool_parallel": "Parallel",
        "tool_perplexity": "Perplexity"
      }
    }
  }
}
