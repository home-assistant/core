{
  "config": {
    "abort": {
      "already_configured": "[%key:common::config_flow::abort::already_configured_device%]",
      "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]"
    },
    "error": {
      "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]",
      "unknown": "[%key:common::config_flow::error::unknown%]"
    },
    "flow_title": "{host}",
    "step": {
      "discovery_confirm": {
        "description": "Do you want to set up the Roth Touchline controller at {host}?"
      },
      "manual": {
        "data": {
          "host": "[%key:common::config_flow::data::host%]"
        },
        "data_description": {
          "host": "The URL of your Roth Touchline controller, for example `http://192.168.1.1`."
        }
      },
      "user": {
        "data": {
          "device": "Controller"
        },
        "data_description": {
          "device": "Controllers that are already set up are not listed."
        },
        "description": "Select a controller found on your network, or enter its URL manually."
      }
    }
  },
  "entity": {
    "climate": {
      "climate": {
        "state_attributes": {
          "preset_mode": {
            "state": {
              "program_1": "Program 1",
              "program_2": "Program 2",
              "program_3": "Program 3"
            }
          }
        }
      }
    }
  },
  "exceptions": {
    "error_set_preset": {
      "message": "An error occurred while setting the preset mode."
    },
    "error_set_temperature": {
      "message": "An error occurred while setting the temperature."
    }
  },
  "selector": {
    "device": {
      "options": {
        "manual": "Enter the URL manually"
      }
    }
  }
}
