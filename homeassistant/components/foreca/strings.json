{
  "config": {
    "abort": {
      "already_configured": "[%key:common::config_flow::abort::already_configured_location%]",
      "reauth_successful": "[%key:common::config_flow::abort::reauth_successful%]"
    },
    "error": {
      "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]",
      "invalid_auth": "[%key:common::config_flow::error::invalid_auth%]",
      "unknown": "[%key:common::config_flow::error::unknown%]"
    },
    "step": {
      "reauth_confirm": {
        "data": {
          "api_key": "[%key:common::config_flow::data::api_key%]"
        },
        "data_description": {
          "api_key": "[%key:component::foreca::config::step::user::data_description::api_key%]"
        },
        "description": "The Foreca Weather API rejected the API key for {location}. Enter a new one from the My API page."
      },
      "user": {
        "data": {
          "api_key": "[%key:common::config_flow::data::api_key%]",
          "location": "[%key:common::config_flow::data::location%]"
        },
        "data_description": {
          "api_key": "Your Foreca Weather API key from the My API page",
          "location": "Coordinates to get the weather forecast for"
        },
        "description": "Create a free account at developer.foreca.com to get an API key."
      }
    }
  }
}
