        "name": "Copied pages",
        "unit_of_measurement": "[%key:component::hp_printer::entity::sensor::total_pages::unit_of_measurement%]"
      },
      "cyan_level": {
        "name": "Cyan level"
      },
      "cyan_pages_remaining": {
