      "reauth_successful": "[%key:common::config_flow::abort::reauth_successful%]"
    },
    "create_entry": {
      "default": "[%key:common::config_flow::create_entry::authenticated%]"
    },
    "step": {
      "pick_implementation": {
        "data": {
          "implementation": "[%key:common::config_flow::data::implementation%]"
        },
        "data_description": {
          "implementation": "[%key:common::config_flow::description::implementation%]"
        },
        "title": "[%key:common::config_flow::title::oauth2_pick_implementation%]"
      },
      "reauth_confirm": {
        "description": "The Geocaching integration needs to re-authenticate your account",
        "title": "[%key:common::config_flow::title::reauth%]"
      }
    }
  },
  "config_subentries": {
    "tracked_cache": {
      "abort": {
        "too_many_caches": "A maximum of 50 caches can be tracked."
      },
      "entry_type": "Tracked cache",
      "error": {
        "already_configured": "This cache is already configured.",
        "invalid_cache_code": "Enter a valid geocache code."
      },
      "initiate_flow": {
        "user": "Add tracked cache"
      },
      "step": {
        "user": {
          "data": {
            "code": "Geocache code"
          },
          "data_description": {
            "code": "Enter one geocache code, for example GC12345."
          },
          "description": "Add one geocache to track by entering its geocache code.",
          "title": "Add tracked cache"
        }
      }
    }
  },
  "entity": {
    "sensor": {
      "awarded_favorite_points": {
        "name": "Awarded favorite points",
        "unit_of_measurement": "points"
      },
      "cache_favorite_points": {
        "name": "Favorite points",
        "unit_of_measurement": "points"
      },
      "cache_found_date": {
        "name": "Found date"
      },
      "cache_hidden_date": {
        "name": "Hidden date"
      },
      "favorite_points": {
        "name": "Favorite points",
        "unit_of_measurement": "points"
      },
      "find_count": {
        "name": "Total finds",
        "unit_of_measurement": "caches"
      },
      "hide_count": {
        "name": "Total hides",
        "unit_of_measurement": "caches"
      },
      "souvenir_count": {
        "name": "Total souvenirs",
        "unit_of_measurement": "souvenirs"
      },
      "trackable_kilometers_traveled": {
        "name": "Distance traveled"
      }
