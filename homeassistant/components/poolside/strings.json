          "idle": "Idle",
          "offline": "Offline",
          "overload": "Overload",
          "waiting_to_move": "Waiting"
        }
      },
      "current_state": {
        "name": "Water state",
        "state": {
          "cooldown": "Cooldown",
          "cooling": "Cooling",
          "critical_alert": "Critical alert",
          "filtering": "Filtering",
          "heating": "Heating",
          "installer_mode": "Installer mode",
          "off": "[%key:common::state::off%]",
          "on": "Running"
