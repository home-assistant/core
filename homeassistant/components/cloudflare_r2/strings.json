{
  "config": {
    "abort": {
      "already_configured": "[%key:common::config_flow::abort::already_configured_device%]"
    },
    "error": {
      "bucket_not_found": "Bucket does not exist. Check the bucket name and endpoint URL.",
      "cannot_connect": "[%key:component::cloudflare_r2::exceptions::cannot_connect::message%]",
      "invalid_bucket_name": "[%key:component::cloudflare_r2::exceptions::invalid_bucket_name::message%]",
      "invalid_credentials": "[%key:component::cloudflare_r2::exceptions::invalid_credentials::message%]",
      "invalid_endpoint_url": "[%key:component::cloudflare_r2::exceptions::invalid_endpoint_url::message%]",
      "unknown": "[%key:common::config_flow::error::unknown%]"
    },
    "step": {
      "reauth_confirm": {
        "data": {
          "access_key_id": "[%key:component::cloudflare_r2::config::step::user::data::access_key_id%]",
          "secret_access_key": "[%key:component::cloudflare_r2::config::step::user::data::secret_access_key%]"
        },
        "data_description": {
          "access_key_id": "[%key:component::cloudflare_r2::config::step::user::data_description::access_key_id%]",
          "secret_access_key": "[%key:component::cloudflare_r2::config::step::user::data_description::secret_access_key%]"
        },
        "description": "The credentials for bucket {name} are no longer valid. Enter a new access key ID and secret access key.",
        "title": "[%key:common::config_flow::title::reauth%]"
      },
      "reconfigure": {
        "data": {
          "access_key_id": "[%key:component::cloudflare_r2::config::step::user::data::access_key_id%]",
          "bucket": "[%key:component::cloudflare_r2::config::step::user::data::bucket%]",
          "endpoint_url": "[%key:component::cloudflare_r2::config::step::user::data::endpoint_url%]",
          "prefix": "[%key:component::cloudflare_r2::config::step::user::data::prefix%]",
          "secret_access_key": "[%key:component::cloudflare_r2::config::step::user::data::secret_access_key%]"
        },
        "data_description": {
          "access_key_id": "[%key:component::cloudflare_r2::config::step::user::data_description::access_key_id%]",
          "bucket": "[%key:component::cloudflare_r2::config::step::user::data_description::bucket%]",
          "endpoint_url": "[%key:component::cloudflare_r2::config::step::user::data_description::endpoint_url%]",
          "prefix": "[%key:component::cloudflare_r2::config::step::user::data_description::prefix%]",
          "secret_access_key": "[%key:component::cloudflare_r2::config::step::user::data_description::secret_access_key%]"
        },
        "title": "Reconfigure Cloudflare R2 bucket"
      },
      "user": {
        "data": {
          "access_key_id": "Access key ID",
          "bucket": "Bucket name",
          "endpoint_url": "Endpoint URL",
          "prefix": "Folder prefix (optional)",
          "secret_access_key": "Secret access key"
        },
        "data_description": {
          "access_key_id": "Access key ID to connect to Cloudflare R2",
          "bucket": "Bucket must already exist and be writable by the provided credentials.",
          "endpoint_url": "Cloudflare R2 S3-compatible endpoint.",
          "prefix": "Optional folder path inside the bucket. Example: backups/homeassistant",
          "secret_access_key": "Secret access key to connect to Cloudflare R2. See [Cloudflare documentation]({auth_docs_url})"
        },
        "title": "Add Cloudflare R2 bucket"
      }
    }
  },
  "exceptions": {
    "bucket_not_found": {
      "message": "Bucket {bucket} does not exist. Reconfigure the integration to use an existing bucket."
    },
    "cannot_connect": {
      "message": "Cannot connect to endpoint"
    },
    "invalid_bucket_name": {
      "message": "Invalid bucket name"
    },
    "invalid_credentials": {
      "message": "Bucket cannot be accessed using provided access key ID and secret."
    },
    "invalid_endpoint_url": {
      "message": "Invalid endpoint URL. Please enter a valid Cloudflare R2 endpoint URL."
    }
  }
}
