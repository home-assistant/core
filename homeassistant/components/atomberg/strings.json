      "led": {
        "name": "LED"
      }
    },
    "number": {
      "tds_threshold": {
        "name": "TDS threshold"
      }
    },
    "select": {
      "timer": {
        "name": "Timer",
        "state": {
          "off": "[%key:common::state::off%]",
