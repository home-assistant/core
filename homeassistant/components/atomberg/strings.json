{
  "config": {
    "step": {
      "user": {
        "title": "Connect your Atomberg account",
        "description": "Enable developer mode in the Atomberg Home app to generate an API key and refresh token. See the [Atomberg developer portal]({portal_url}) for details.",
        "data": {
          "api_key": "[%key:common::config_flow::data::api_key%]",
          "refresh_token": "Refresh token"
        },
        "data_description": {
          "api_key": "The API key generated in the Atomberg Home app.",
          "refresh_token": "The refresh token generated in the Atomberg Home app."
        }
      },
      "reauth_confirm": {
        "title": "[%key:common::config_flow::title::reauth%]",
        "description": "The Atomberg credentials are no longer valid. Enter a new API key and refresh token for the same account.",
        "data": {
          "api_key": "[%key:common::config_flow::data::api_key%]",
          "refresh_token": "Refresh token"
        },
        "data_description": {
          "api_key": "[%key:component::atomberg::config::step::user::data_description::api_key%]",
          "refresh_token": "[%key:component::atomberg::config::step::user::data_description::refresh_token%]"
        }
      }
    },
    "error": {
      "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]",
      "invalid_auth": "[%key:common::config_flow::error::invalid_auth%]",
      "unknown": "[%key:common::config_flow::error::unknown%]"
    },
    "abort": {
      "already_configured": "[%key:common::config_flow::abort::already_configured_account%]",
      "wrong_account": "The new credentials belong to a different account."
    }
  },
