{
  "config": {
    "abort": {
      "already_configured": "[%key:common::config_flow::abort::already_configured_service%]"
    },
    "error": {
      "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]",
      "invalid_auth": "[%key:common::config_flow::error::invalid_auth%]",
      "unknown": "[%key:common::config_flow::error::unknown%]"
    },
    "step": {
      "reauth_confirm": {
        "data": {
          "api_token": "[%key:common::config_flow::data::api_token%]"
        },
        "description": "[%key:component::discord::config::step::user::description%]"
      },
      "user": {
        "data": {
          "api_token": "[%key:common::config_flow::data::api_token%]"
        },
        "description": "Refer to the documentation on getting your Discord bot key.\n\n{url}"
      }
    }
  },
  "config_subentries": {
    "target": {
      "abort": {
        "already_configured": "This target is already configured"
      },
      "entry_type": "Target",
      "error": {
        "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]",
        "invalid_auth": "[%key:common::config_flow::error::invalid_auth%]",
        "invalid_target": "The target ID must be a number",
        "target_not_found": "Target not found",
        "unknown": "[%key:common::config_flow::error::unknown%]"
      },
      "initiate_flow": {
        "user": "Add target"
      },
      "step": {
        "user": {
          "data": {
            "target_id": "Target ID"
          },
          "data_description": {
            "target_id": "ID of the channel, user or DM to send notifications to."
          },
          "title": "Add target"
        }
      }
    }
  },
  "exceptions": {
    "send_failed": {
      "message": "Error sending message to Discord: {error}"
    },
    "target_not_found": {
      "message": "Target not found for ID: {target}"
    }
  }
}
