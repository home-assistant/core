{
  "config": {
    "abort": {
      "already_configured": "[%key:common::config_flow::abort::already_configured_device%]",
      "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]",
      "invalid_auth": "[%key:common::config_flow::error::invalid_auth%]"
    },
    "error": {
      "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]",
      "invalid_auth": "[%key:common::config_flow::error::invalid_auth%]"
    },
    "step": {
      "reauth_confirm": {
        "data": {
          "password": "[%key:common::config_flow::data::password%]"
        },
        "description": "The password for {email} is no longer valid. Please enter the new password.",
        "title": "[%key:common::config_flow::title::reauth%]"
      },
      "user": {
        "data": {
          "email": "[%key:common::config_flow::data::email%]",
          "password": "[%key:common::config_flow::data::password%]"
        },
        "title": "Set up Rheem EcoNet Account"
      }
    }
  },
  "entity": {
    "binary_sensor": {
      "beep_enabled": {
        "name": "Beep enabled"
      },
      "running": {
        "name": "Running"
      },
      "screen_locked": {
        "name": "Screen locked"
      },
      "shutoff_valve": {
        "name": "Shutoff valve"
      }
    },
    "sensor": {
      "alert_count": {
        "name": "Alert count"
      },
      "available_hot_water": {
        "name": "Available hot water"
      },
      "compressor_health": {
        "name": "Compressor health"
      },
      "override_status": {
        "name": "Override status"
      },
      "power_usage_today": {
        "name": "Energy usage today"
      },
      "running_state": {
        "name": "Running state"
      },
      "tank_health": {
        "name": "Tank health"
      },
      "water_usage_today": {
        "name": "Water usage today"
      },
      "wifi_signal": {
        "name": "Wi-Fi signal"
      }
    }
  },
  "exceptions": {
    "invalid_credentials": {
      "message": "Invalid credentials provided"
    }
  },
  "issues": {
    "migrate_aux_heat": {
      "fix_flow": {
        "step": {
          "confirm": {
            "description": "The EcoNet `set_aux_heat` action has been migrated. A new `aux_heat_only` switch entity is available for each thermostat.\n\nUpdate any automations to use the new `aux_heat_only` switch entity. When this is done, select **Submit** to fix this issue.",
            "title": "[%key:component::econet::issues::migrate_aux_heat::title%]"
          }
        }
      },
      "title": "Migration of EcoNet set_aux_heat action"
    }
  }
}
