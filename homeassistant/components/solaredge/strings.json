{
  "application_credentials": {
    "description": "Create a **Site Access** application in the [SolarEdge Developer Console]({developer_console_url}). Enable the `SITE_DATA` and `DEVICE_DATA` scopes and register this exact redirect URI: `{redirect_url}`. The URI must use an externally reachable Home Assistant URL. Copy the client ID and client secret into Home Assistant."
  },
  "config": {
    "abort": {
      "already_configured": "[%key:common::config_flow::abort::already_configured_device%]",
      "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]",
      "site_not_active": "The selected SolarEdge site is not active.",
      "wrong_account": "The authenticated account does not provide access to this SolarEdge site."
    },
    "error": {
      "already_configured": "[%key:common::config_flow::abort::already_configured_device%]",
      "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]",
      "invalid_auth": "[%key:common::config_flow::error::invalid_auth%]",
      "unknown": "[%key:common::config_flow::error::unknown%]"
    },
    "step": {
      "reconfigure": {
        "data": {
          "password": "[%key:common::config_flow::data::password%]",
          "username": "[%key:common::config_flow::data::username%]"
        },
        "data_description": {
          "password": "[%key:component::solaredge::config::step::user::data_description::password%]",
          "username": "[%key:component::solaredge::config::step::user::data_description::username%]"
        },
        "description": "Update the optional module-level web account credentials for site {site_id}.",
        "sections": {
          "web_auth": {
            "data": {
              "password": "[%key:common::config_flow::data::password%]",
              "username": "[%key:common::config_flow::data::username%]"
            },
            "description": "[%key:component::solaredge::config::step::user::sections::web_auth::description%]",
            "name": "[%key:component::solaredge::config::step::user::sections::web_auth::name%]"
          }
        },
        "title": "Reconfigure SolarEdge"
      },
      "user": {
        "data": {
          "password": "[%key:common::config_flow::data::password%]",
          "site_id": "The SolarEdge site ID",
          "username": "[%key:common::config_flow::data::username%]"
        },
        "data_description": {
          "password": "Required if username is provided",
          "site_id": "The numeric site ID shown in the SolarEdge monitoring portal",
          "username": "Optional, used only for module-level production statistics"
        },
        "description": "Enter the site ID. You will authorize Home Assistant through SolarEdge in the next step.",
        "sections": {
          "web_auth": {
            "data": {
              "password": "[%key:common::config_flow::data::password%]",
              "username": "[%key:common::config_flow::data::username%]"
            },
            "description": "Optional legacy web portal credentials for non-real-time module-level production statistics",
            "name": "Module statistics"
          }
        },
        "title": "Set up your SolarEdge integration"
      },
      "pick_implementation": {
        "title": "[%key:common::config_flow::title::oauth2_pick_implementation%]"
      },
      "reauth_confirm": {
        "description": "SolarEdge retired site API keys. Reconnect site {site_id} with a Site Access OAuth application.",
        "title": "[%key:common::config_flow::title::reauth%]"
      }
    }
  },
