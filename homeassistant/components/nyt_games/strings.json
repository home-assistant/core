{
  "config": {
    "abort": {
      "already_configured": "[%key:common::config_flow::abort::already_configured_account%]",
      "unique_id_mismatch": "The provided token belongs to a different account than the configured one."
    },
    "error": {
      "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]",
      "invalid_auth": "[%key:common::config_flow::error::invalid_auth%]",
      "unknown": "[%key:common::config_flow::error::unknown%]"
    },
    "initiate_flow": {
      "user": "[%key:common::config_flow::initiate_flow::account%]"
    },
    "step": {
      "reauth_confirm": {
        "data": {
          "token": "[%key:component::nyt_games::config::step::user::data::token%]"
        },
        "data_description": {
          "token": "[%key:component::nyt_games::config::step::user::data_description::token%]"
        },
        "description": "The token for your NYT Games account has expired or is invalid. Please enter a new token."
      },
      "reconfigure": {
        "data": {
          "token": "[%key:component::nyt_games::config::step::user::data::token%]"
        },
        "data_description": {
          "token": "[%key:component::nyt_games::config::step::user::data_description::token%]"
        }
      },
      "user": {
        "data": {
          "token": "Token"
        },
        "data_description": {
          "token": "The NYT Games NYT-S cookie value."
        }
      }
    }
  },
  "entity": {
    "sensor": {
      "connections_played": {
        "name": "[%key:component::nyt_games::entity::sensor::wordles_played::name%]"
      },
      "last_played": {
        "name": "Last played"
      },
      "max_streak": {
        "name": "Highest streak"
      },
      "spelling_bees_played": {
        "name": "[%key:component::nyt_games::entity::sensor::wordles_played::name%]"
      },
      "streak": {
        "name": "Current streak"
      },
      "total_pangrams": {
        "name": "Total pangrams found"
      },
      "total_words": {
        "name": "Total words found"
      },
      "won": {
        "name": "Won"
      },
      "wordles_played": {
        "name": "Played"
      }
    }
  },
  "exceptions": {
    "authentication_error": {
      "message": "Authentication with NYT Games failed. Please reauthenticate."
    },
    "update_error": {
      "message": "An error occurred while fetching data from NYT Games: {error}"
    }
  }
