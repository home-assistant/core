{
  "config": {
    "abort": {
      "already_configured": "[%key:common::config_flow::abort::already_configured_location%]"
    },
    "error": {
      "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]",
      "municipality_not_found": "No Austrian municipality was found at the selected location.",
      "unknown": "[%key:common::config_flow::error::unknown%]"
    },
    "step": {
      "user": {
        "data": {
          "location": "[%key:common::config_flow::data::location%]"
        },
        "data_description": {
          "location": "Warnings are provided for the Austrian municipality at this location."
        },
        "description": "Select the location to monitor for official GeoSphere Austria weather warnings."
      }
    }
  },
  "entity": {
    "event": {
      "warning": {
        "name": "Warning",
        "state_attributes": {
          "change_id": {
            "name": "Change ID"
          },
          "course_id": {
            "name": "Course ID"
          },
          "end": {
            "name": "End"
          },
          "event_type": {
            "state": {
              "issued": "Issued",
              "updated": "Updated"
            }
          },
          "impacts": {
            "name": "Impacts"
          },
          "level": {
            "name": "Level",
            "state": {
              "orange": "[%key:component::geosphere_austria_warnings::entity::sensor::active_warning_level::state::orange%]",
              "red": "[%key:component::geosphere_austria_warnings::entity::sensor::active_warning_level::state::red%]",
              "yellow": "[%key:component::geosphere_austria_warnings::entity::sensor::active_warning_level::state::yellow%]"
            }
          },
          "meteo_text": {
            "name": "Meteorological description"
          },
          "recommendations": {
            "name": "Recommendations"
          },
          "start": {
            "name": "Start"
          },
          "text": {
            "name": "Text"
          },
          "type": {
            "name": "Type",
            "state": {
              "black_ice": "Black ice",
              "cold": "Cold",
              "heat": "Heat",
              "rain": "Rain",
              "snow": "Snow",
              "storm": "Storm",
              "thunderstorm": "Thunderstorm"
            }
          },
          "update_reason": {
            "name": "Update reason"
          },
          "warning_id": {
            "name": "Warning ID"
          }
        }
      }
    },
    "sensor": {
      "active_warning_level": {
        "name": "Active warning level",
        "state": {
          "none": "No warning",
          "orange": "Orange",
          "red": "Red",
          "yellow": "Yellow"
        }
      },
      "active_warnings": {
        "name": "Active warnings",
        "unit_of_measurement": "warnings"
      },
      "advance_warning_level": {
        "name": "Advance warning level",
        "state": {
          "none": "No warning",
          "orange": "Orange",
          "red": "Red",
          "yellow": "Yellow"
        }
      },
      "advance_warnings": {
        "name": "Advance warnings",
        "unit_of_measurement": "warnings"
      }
    }
  },
  "exceptions": {
    "api_error": {
      "message": "The GeoSphere Austria Warn API returned an unexpected response: {error}"
    },
    "connection_error": {
      "message": "Error communicating with the GeoSphere Austria Warn API: {error}"
    },
    "entity_migration_conflict": {
      "message": "Cannot migrate the warning-level sensor: unique ID {new_unique_id} is already used by entity {conflicting_entity_id}."
    },
    "municipality_not_found": {
      "message": "No Austrian municipality was found for the configured location"
    },
    "warnings_unavailable": {
      "message": "Weather warnings are unavailable because the last update failed."
    }
  },
  "services": {
    "get_warnings": {
      "description": "Retrieves the active and advance weather warnings for a location.",
      "fields": {
        "config_entry_id": {
          "description": "The GeoSphere Austria Warnings configuration entry to query.",
          "name": "Location"
        }
      },
      "name": "Get warnings"
    }
  }
}
