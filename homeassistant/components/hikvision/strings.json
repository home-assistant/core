  "exceptions": {
    "cannot_connect": {
      "message": "[%key:common::config_flow::error::cannot_connect%]"
    },
    "image_setting_conflict_hlc": {
      "message": "This setting cannot be turned on while highlight compensation is on. Turn highlight compensation off first."
    },
    "image_setting_conflict_wdr": {
      "message": "Highlight compensation cannot be turned on while wide dynamic range or defog is on. Turn those off first."
    },
    "image_setting_error": {
      "message": "The device did not accept the image setting."
    },
    "image_setting_not_allowed": {
      "message": "This user is not allowed to change the image settings of the device."
    },
    "image_setting_refused": {
      "message": "The device did not accept the image setting ({code})."
    },
    "image_settings_update_failed": {
      "message": "Unable to read the image settings."
    },
