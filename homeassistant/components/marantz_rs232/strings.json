              "dvd": "[%key:component::marantz_rs232::entity::media_player::receiver::state_attributes::source::state::dvd%]",
              "fm": "[%key:component::marantz_rs232::entity::media_player::receiver::state_attributes::source::state::fm%]",
              "tape": "[%key:component::marantz_rs232::entity::media_player::receiver::state_attributes::source::state::tape%]",
