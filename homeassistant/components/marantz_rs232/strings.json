              "aux2": "[%key:component::marantz_rs232::entity::media_player::receiver::state_attributes::source::state::aux2%]",
              "cd_cdr": "[%key:component::marantz_rs232::entity::media_player::receiver::state_attributes::source::state::cd_cdr%]",
