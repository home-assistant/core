{
  "entity": {
    "sensor": {
      "arm_status": {
        "default": "mdi:shield-off-outline",
        "state": {
          "bypass_needed": "mdi:shield-alert",
          "ready": "mdi:shield-check"
        }
      }
    }
  },
  "services": {
    "capture_smartcam": {
      "service": "mdi:camera"
    },
    "disable_autolock": {
      "service": "mdi:lock-off"
    },
    "enable_autolock": {
      "service": "mdi:lock"
    }
  }
}
