    "cannot_connect": {
      "message": "Could not connect to the Microsoft Text-to-Speech service."
    },
    "invalid_api_key": {
      "message": "The Microsoft Text-to-Speech service rejected the API key. Check that the API key is valid and that the region matches your Azure Speech resource."
