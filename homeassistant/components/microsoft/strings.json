  "issues": {
    "deprecated_yaml": {
      "description": "Configuring {integration_title} using YAML is being removed.\n\nYour existing YAML configuration has been imported into the UI automatically. The legacy `tts.{domain}_say` action (or the name you set with `service_name`) and the legacy `{domain}` text-to-speech engine keep working until you remove the YAML configuration. To fix this issue:\n\n1. Update your automations and scripts to use the `tts.speak` action with the new text-to-speech entity.\n2. Under **Settings** > **Voice assistants**, select the new text-to-speech entity in every assistant that uses the legacy `{domain}` engine.\n3. Remove the `{domain}` platform from the `tts` section of your configuration.yaml file and restart Home Assistant.",
      "title": "[%key:component::homeassistant::issues::deprecated_yaml::title%]"
    },
    "deprecated_yaml_import_issue_cannot_connect": {
      "description": "Configuring {integration_title} using YAML is being removed, but your YAML configuration could not be imported because Home Assistant could not connect to the Microsoft Text-to-Speech service.\n\nCheck the region in your YAML configuration and restart Home Assistant to try again, or remove the `{domain}` platform from the `tts` section of your configuration.yaml file and set up the integration in the UI.",
      "title": "The {integration_title} YAML configuration import failed"
    },
    "deprecated_yaml_import_issue_invalid_api_key": {
      "description": "Configuring {integration_title} using YAML is being removed, but your YAML configuration could not be imported because the API key was rejected.\n\nCheck the API key and region in your YAML configuration and restart Home Assistant to try again, or remove the `{domain}` platform from the `tts` section of your configuration.yaml file and set up the integration in the UI.",
      "title": "[%key:component::microsoft::issues::deprecated_yaml_import_issue_cannot_connect::title%]"
    },
    "deprecated_yaml_import_issue_unknown": {
      "description": "Configuring {integration_title} using YAML is being removed, but your YAML configuration could not be imported because of an unexpected error. Check the logs for details.\n\nRemove the `{domain}` platform from the `tts` section of your configuration.yaml file and set up the integration in the UI.",
      "title": "[%key:component::microsoft::issues::deprecated_yaml_import_issue_cannot_connect::title%]"
    }
  },
