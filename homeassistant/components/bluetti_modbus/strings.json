{
  "config": {
    "abort": {
      "already_configured": "[%key:common::config_flow::abort::already_configured_device%]",
      "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]",
      "reconfigure_successful": "[%key:common::config_flow::abort::reconfigure_successful%]",
      "wrong_device": "The device at that address and device ID is a different device than the one this entry is set up for."
    },
    "error": {
      "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]",
      "unsupported_device_type": "This device type is not supported by the installed version of bluetti-modbus."
    },
    "step": {
      "reconfigure": {
        "data": {
          "device_type": "[%key:component::bluetti_modbus::config::step::user::data::device_type%]",
          "host": "[%key:common::config_flow::data::host%]",
          "port": "[%key:common::config_flow::data::port%]",
          "unit_id": "[%key:component::bluetti_modbus::config::step::user::data::unit_id%]"
        },
        "data_description": {
          "device_type": "[%key:component::bluetti_modbus::config::step::user::data_description::device_type%]",
          "host": "[%key:component::bluetti_modbus::config::step::user::data_description::host%]",
          "port": "[%key:component::bluetti_modbus::config::step::user::data_description::port%]",
          "unit_id": "[%key:component::bluetti_modbus::config::step::user::data_description::unit_id%]"
        },
        "description": "Update how this device is reached, for example after it moved to another address."
      },
      "user": {
        "data": {
          "device_type": "Model",
          "host": "[%key:common::config_flow::data::host%]",
          "port": "[%key:common::config_flow::data::port%]",
          "unit_id": "Device ID"
        },
        "data_description": {
          "device_type": "The BLUETTI power station model you are connecting to.",
          "host": "The hostname or IP address of your BLUETTI power station.",
          "port": "The TCP port the device listens on for Modbus requests. The BLUETTI default is 502.",
          "unit_id": "The Modbus device ID of the power station. The BLUETTI default is 1."
        },
        "description": "Connect to your BLUETTI power station over Modbus to monitor it locally."
      }
    }
  },
