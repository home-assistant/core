{
  "domain": "airobot",
  "name": "Airobot",
  "codeowners": ["@mettolen"],
  "config_flow": true,
  "dependencies": ["modbus"],
  "dhcp": [
    {
      "hostname": "airobot-thermostat-*"
    },
    {
      "hostname": "airobot-ventilation"
    }
  ],
  "documentation": "https://www.home-assistant.io/integrations/airobot",
  "integration_type": "device",
  "iot_class": "local_polling",
  "loggers": [
    "modbus_connection",
    "pyairobotmodbus",
    "pyairobotrest",
    "tmodbus"
  ],
  "quality_scale": "platinum",
  "requirements": ["pyairobotmodbus==1.0.0", "pyairobotrest==0.4.0"]
}
