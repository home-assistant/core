# name: test_parameters_openapi
  dict({
    'additionalProperties': False,
    'properties': dict({
      'end_time': dict({
        'description': 'End of the period as an ISO 8601 datetime. Local time is used when no UTC offset is given (default: now).',
        'type': 'string',
      }),
      'entity_ids': dict({
        'description': "Entity IDs to get the history for (e.g. 'sensor.outside_temperature').",
        'items': dict({
          'type': 'string',
        }),
        'minItems': 1,
        'type': 'array',
      }),
      'include_full_attributes': dict({
        'default': False,
        'description': "Only for source 'state_changes': whether to include all state attributes as JSON, for example the media details of a media player (default: false).",
        'type': 'boolean',
      }),
      'limit': dict({
        'default': 100,
        'description': 'Maximum number of rows to return per entity (default: 100, max: 1000).',
        'maximum': 1000,
        'minimum': 1,
        'type': 'integer',
      }),
      'period': dict({
        'description': "Only for source 'statistics': the length of each aggregated row. 5minute rows are usually kept for 10 days (default: picked from the length of the requested time span).",
        'enum': list([
          '5minute',
          'hour',
          'day',
          'week',
          'month',
        ]),
        'type': 'string',
      }),
      'source': dict({
        'default': 'statistics',
        'description': "'statistics' for aggregated values or 'state_changes' for each recorded state change (default: 'statistics').",
        'enum': list([
          'statistics',
          'state_changes',
        ]),
        'type': 'string',
      }),
      'start_time': dict({
        'description': 'Start of the period as an ISO 8601 datetime. Local time is used when no UTC offset is given (default: 24 hours before end_time).',
        'type': 'string',
      }),
    }),
    'required': list([
      'entity_ids',
    ]),
    'type': 'object',
  })
