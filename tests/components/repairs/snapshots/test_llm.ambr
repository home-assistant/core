      'annotations': dict({
        'destructive': True,
        'idempotent': False,
        'open_world': True,
        'read_only': False,
      }),
      'description': "Start a repair fix flow for a fixable Home Assistant repair issue and return its initial step. Use repairs__get_issues first to find the issue's 'domain' and 'issue_id' (only issues with 'is_fixable: true' have a fix flow).",
      'parameters': dict({
        'additionalProperties': False,
        'properties': dict({
